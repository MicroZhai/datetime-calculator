{
  "schemaVersion": 1,
  "description": "Shared conformance fixtures for Web and future HarmonyOS/ArkTS implementations.",
  "dateTimezone": "UTC",
  "format": [
    {
      "id": "zero-duration-text",
      "operation": "durationText",
      "milliseconds": "0",
      "expected": "0分"
    },
    {
      "id": "mixed-duration-with-millisecond-tail",
      "operation": "durationText",
      "milliseconds": "90061001",
      "expected": "1天1小时1分1.001秒"
    },
    {
      "id": "negative-subsecond-duration",
      "operation": "durationText",
      "milliseconds": "-1001",
      "expected": "-1.001秒"
    },
    {
      "id": "huge-hms-never-scientific-notation",
      "operation": "hms",
      "milliseconds": "25920000000000001",
      "expected": "7200000000:00:00.001"
    },
    {
      "id": "negative-hms",
      "operation": "hms",
      "milliseconds": "-3661001",
      "expected": "-01:01:01.001"
    },
    {
      "id": "decimal-hour-standard-rounding",
      "operation": "roundedRatio",
      "milliseconds": "28851000",
      "divisor": "hour",
      "decimals": 6,
      "expected": "8.014167"
    },
    {
      "id": "decimal-hour-one-ms-rounds-to-zero",
      "operation": "roundedRatio",
      "milliseconds": "1",
      "divisor": "hour",
      "decimals": 6,
      "expected": "0"
    },
    {
      "id": "negative-decimal-hour-one-ms-never-shows-negative-zero",
      "operation": "roundedRatio",
      "milliseconds": "-1",
      "divisor": "hour",
      "decimals": 6,
      "expected": "0"
    },
    {
      "id": "decimal-hour-two-ms-rounds-up",
      "operation": "roundedRatio",
      "milliseconds": "2",
      "divisor": "hour",
      "decimals": 6,
      "expected": "0.000001"
    },
    {
      "id": "decimal-hour-rounding-carries-to-next-hour",
      "operation": "roundedRatio",
      "milliseconds": "3599999",
      "divisor": "hour",
      "decimals": 6,
      "expected": "1"
    },
    {
      "id": "sexagesimal-keeps-exact-value-at-hour-carry-boundary",
      "operation": "hms",
      "milliseconds": "3599999",
      "expected": "00:59:59.999"
    },
    {
      "id": "decimal-minute-one-ms",
      "operation": "roundedRatio",
      "milliseconds": "1",
      "divisor": "minute",
      "decimals": 6,
      "expected": "0.000017"
    },
    {
      "id": "negative-decimal-hour-rounding",
      "operation": "roundedRatio",
      "milliseconds": "-2",
      "divisor": "hour",
      "decimals": 6,
      "expected": "-0.000001"
    },
    {
      "id": "negative-composite-parts-preserve-total-sign",
      "operation": "millisecondsToParts",
      "milliseconds": "-5400001",
      "expected": [
        { "kind": "unit", "unit": "h", "value": "-1" },
        { "kind": "unit", "unit": "m", "value": "-30" },
        { "kind": "unit", "unit": "s", "value": "-0.001" }
      ]
    }
  ],
  "date": [
    {
      "id": "date-only-to-midnight",
      "operation": "normalizeAnchor",
      "input": "2026-08-09",
      "expected": "2026-08-09T00:00"
    },
    {
      "id": "leap-day-valid",
      "operation": "parseValid",
      "input": "2028-02-29T12:30",
      "expected": true
    },
    {
      "id": "non-leap-day-invalid",
      "operation": "parseValid",
      "input": "2026-02-29T00:00",
      "expected": false
    },
    {
      "id": "date-plus-one-millisecond",
      "operation": "mapDuration",
      "anchor": "2026-08-09T00:00",
      "durationMs": "1",
      "expected": {
        "ok": true,
        "date": "2026/08/09",
        "time": "00:00:00.001"
      }
    },
    {
      "id": "date-plus-one-day",
      "operation": "mapDuration",
      "anchor": "2026-08-09T00:00",
      "durationMs": "86400000",
      "expected": {
        "ok": true,
        "date": "2026/08/10",
        "time": "00:00"
      }
    },
    {
      "id": "huge-duration-does-not-break-duration-core",
      "operation": "mapDuration",
      "anchor": "2026-08-09T00:00",
      "durationMs": "25920000000000000",
      "expected": {
        "ok": false,
        "reason": "date-out-of-range"
      }
    }
  ],
  "history": [
    {
      "id": "legacy-number-result-rebuilt-from-rows",
      "operation": "normalizeRecord",
      "input": {
        "createdAt": 42,
        "rows": [
          {
            "op": null,
            "parts": [
              { "kind": "unit", "unit": "d", "value": "300000000" }
            ]
          },
          {
            "op": "+",
            "parts": [
              { "kind": "unit", "unit": "s", "value": "0.001" }
            ]
          }
        ],
        "resultMs": 7,
        "anchorDate": "2026-08-09"
      },
      "expected": {
        "resultMs": "25920000000000001",
        "anchorDateTime": "2026-08-09T00:00",
        "schemaVersion": 2
      }
    },
    {
      "id": "invalid-empty-history-is-dropped",
      "operation": "normalizeRecord",
      "input": {
        "createdAt": 1,
        "rows": [],
        "resultMs": 0
      },
      "expected": null
    }
  ],
  "state": [
    {
      "id": "bigint-date-hour-mode-json-safe",
      "operation": "normalizeSnapshot",
      "input": {
        "rows": [
          {
            "op": null,
            "parts": [
              { "kind": "unit", "unit": "d", "value": "300000000" }
            ]
          }
        ],
        "resultUnit": "h",
        "resultRadix": 10,
        "lastResultMs": "25920000000000000",
        "justEvaluated": true,
        "anchorDateTime": "2026-08-09",
        "hourDisplayMode": "sexagesimal"
      },
      "expected": {
        "lastResultMs": "25920000000000000",
        "anchorDateTime": "2026-08-09T00:00",
        "resultUnit": "h",
        "resultRadix": 10,
        "hourDisplayMode": "sexagesimal",
        "justEvaluated": true
      }
    },
    {
      "id": "unfinished-decimal-is-restorable",
      "operation": "normalizeSnapshot",
      "input": {
        "numberBuffer": "123."
      },
      "expected": {
        "numberBuffer": "123.",
        "hasContent": true
      }
    },
    {
      "id": "unfinished-colon-is-restorable",
      "operation": "normalizeSnapshot",
      "input": {
        "colonMode": true,
        "colonHours": "12345678901234567890",
        "colonMinutes": "5",
        "colonSeconds": "",
        "colonStage": "minute"
      },
      "expected": {
        "colonMode": true,
        "colonHours": "12345678901234567890",
        "colonMinutes": "5",
        "colonStage": "minute",
        "hasContent": true
      }
    },
    {
      "id": "display-only-is-not-content",
      "operation": "normalizeSnapshot",
      "input": {
        "resultUnit": "h",
        "resultRadix": 10,
        "hourDisplayMode": "sexagesimal"
      },
      "expected": {
        "resultUnit": "h",
        "resultRadix": 10,
        "hourDisplayMode": "sexagesimal",
        "hasContent": false
      }
    },
    {
      "id": "history-restore-preserves-display-and-clears-draft",
      "operation": "fromHistoryRecord",
      "record": {
        "rows": [
          {
            "op": null,
            "parts": [
              { "kind": "unit", "unit": "s", "value": "1" }
            ]
          },
          {
            "op": "-",
            "parts": [
              { "kind": "unit", "unit": "s", "value": "2" }
            ]
          }
        ],
        "anchorDateTime": "2026-08-09T00:00"
      },
      "base": {
        "resultUnit": "h",
        "resultRadix": 10,
        "hourDisplayMode": "sexagesimal",
        "numberBuffer": "999"
      },
      "expected": {
        "lastResultMs": "-1000",
        "anchorDateTime": "2026-08-09T00:00",
        "resultUnit": "h",
        "resultRadix": 10,
        "hourDisplayMode": "sexagesimal",
        "numberBuffer": "",
        "justEvaluated": false
      }
    }
  ]
}
